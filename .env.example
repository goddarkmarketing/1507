# Booking cloud sync (Supabase) — required for cross-device bookings / status lookup
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same value as app_secrets.booking_admin_secret in Supabase SQL
NEXT_PUBLIC_BOOKING_ADMIN_SECRET=change-me-long-random-secret

# Public site origin (used in voucher links inside emails / webhooks)
NEXT_PUBLIC_SITE_URL=https://www.krabilinkstaxi.com

# Discord / Slack-compatible webhook — admin alert on every new booking
NEXT_PUBLIC_ADMIN_NOTIFY_WEBHOOK=

# Optional Omise (card) — public key only in static export
# NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxx
